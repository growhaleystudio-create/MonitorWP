{
  "name": "wp-monitoring-backend",
  "version": "1.2.0",
  "description": "Backend for WordPress Monitoring Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "npx prisma db push && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "test:sim": "ts-node src/scripts/test-agent-sim.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.65.1",
    "pdfkit": "^0.19.1",
    "prisma": "^5.12.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
